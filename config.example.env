# Copy this file to config.env and edit the values below.
# config.env is gitignored on purpose since it's local/machine-specific.

# --- Data paths -------------------------------------------------------------
A_DIR=./data/A
B_DIR=./data/B
A_RESIZED=./data/A_resized
B_RESIZED=./data/B_resized
COMBINED_DIR=./data/combined

# --- Training paths ----------------------------------------------------------
CKPT_DIR=./checkpoints/my_model

# --- Export -------------------------------------------------------------------
PICT_OUTPUT=./models/my_custom_model.pict

# --- Hyperparameters -----------------------------------------------------------
WHICH_DIRECTION=AtoB
MAX_EPOCHS=200
LR=0.0001
SAVE_FREQ=100
DISPLAY_FREQ=500
